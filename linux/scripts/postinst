#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="/opt/mianotes"
VENV_DIR="$APP_ROOT/.venv"
WEB_SERVICE_DIR="$APP_ROOT/web-service"
ENV_DIR="/etc/mianotes"
ENV_FILE="$ENV_DIR/mianotes.env"
DATA_DIR="/var/lib/mianotes/data"
LOG_DIR="/var/log/mianotes"

if ! id -u mianotes >/dev/null 2>&1; then
  useradd --system --home /var/lib/mianotes --shell /usr/sbin/nologin mianotes
fi

mkdir -p "$ENV_DIR" "$DATA_DIR" "$LOG_DIR" /var/lib/mianotes

if [[ ! -f "$ENV_FILE" ]]; then
  cat > "$ENV_FILE" <<ENV
MIANOTES_HOST=0.0.0.0
MIANOTES_PORT=8200
MIANOTES_DATA_DIR=$DATA_DIR
MIANOTES_STORAGE_CONFIG_PATH=/var/lib/mianotes/storage.json
ENV
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

export MIANOTES_HOST="${MIANOTES_HOST:-0.0.0.0}"
export MIANOTES_PORT="${MIANOTES_PORT:-8200}"
export MIANOTES_DATA_DIR="${MIANOTES_DATA_DIR:-$DATA_DIR}"
export MIANOTES_STORAGE_CONFIG_PATH="${MIANOTES_STORAGE_CONFIG_PATH:-/var/lib/mianotes/storage.json}"

python3 -m venv "$VENV_DIR"
"$VENV_DIR/bin/python" -m pip install --upgrade pip
"$VENV_DIR/bin/python" -m pip install "$WEB_SERVICE_DIR"

chown -R mianotes:mianotes /var/lib/mianotes "$LOG_DIR"

runuser -u mianotes -- env \
  MIANOTES_HOST="$MIANOTES_HOST" \
  MIANOTES_PORT="$MIANOTES_PORT" \
  MIANOTES_DATA_DIR="$MIANOTES_DATA_DIR" \
  MIANOTES_STORAGE_CONFIG_PATH="$MIANOTES_STORAGE_CONFIG_PATH" \
  "$VENV_DIR/bin/mianotes-web-service" init-db

chmod 755 "$APP_ROOT/bin/start-web-service.sh" "$APP_ROOT/bin/start-dashboard.sh" /usr/bin/mianotes
chmod 644 /lib/systemd/system/mianotes-web-service.service /lib/systemd/system/mianotes-dashboard.service

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  systemctl enable --now mianotes-web-service.service || true
  systemctl enable --now mianotes-dashboard.service || true
fi

exit 0
