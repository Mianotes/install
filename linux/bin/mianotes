#!/usr/bin/env bash
set -euo pipefail

COMMAND="${1:-open}"
APP_ROOT="/opt/mianotes"
ENV_FILE="/etc/mianotes/mianotes.env"
DATA_DIR="/var/lib/mianotes/data"
WORKSPACES_CONFIG="/var/lib/mianotes/workspaces.json"
OLD_STORAGE_CONFIG="/var/lib/mianotes/storage.json"
LOG_DIR="/var/log/mianotes"

require_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    exec sudo "$0" "$@"
  fi
}

print_check() {
  local label="$1"
  local value="$2"

  printf '  %-24s %s\n' "$label" "$value"
}

command_status() {
  local name="$1"
  local path

  if path="$(command -v "$name" 2>/dev/null)"; then
    print_check "$name" "$path"
  else
    print_check "$name" "missing"
  fi
}

systemd_status() {
  local service="$1"

  if systemctl is-active --quiet "$service"; then
    print_check "$service" "running"
  else
    print_check "$service" "not running"
  fi
}

remove_system_state() {
  rm -rf /etc/mianotes
  rm -f "$WORKSPACES_CONFIG" "$OLD_STORAGE_CONFIG"
  rm -f "$DATA_DIR/system.db" "$DATA_DIR/system.db-wal" "$DATA_DIR/system.db-shm" "$DATA_DIR/system.db-journal"
  rm -rf "$DATA_DIR/workspaces"
  rm -rf "$LOG_DIR"
}

case "$COMMAND" in
  open)
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "http://127.0.0.1:8201" >/dev/null 2>&1 &
    else
      echo "Open http://127.0.0.1:8201 in your browser."
    fi
    ;;
  status)
    systemctl status mianotes-web-service.service mianotes-dashboard.service
    ;;
  start)
    sudo systemctl start mianotes-web-service.service mianotes-dashboard.service
    ;;
  stop)
    sudo systemctl stop mianotes-dashboard.service mianotes-web-service.service
    ;;
  restart)
    sudo systemctl restart mianotes-web-service.service mianotes-dashboard.service
    ;;
  doctor)
    echo "Mianotes doctor"
    echo
    echo "Services"
    if command -v systemctl >/dev/null 2>&1; then
      systemd_status "mianotes-web-service.service"
      systemd_status "mianotes-dashboard.service"
    else
      print_check "systemctl" "missing"
    fi
    echo
    echo "Files"
    [[ -d "$APP_ROOT" ]] && print_check "app root" "$APP_ROOT" || print_check "app root" "missing"
    [[ -d "$DATA_DIR" ]] && print_check "data" "$DATA_DIR" || print_check "data" "missing"
    [[ -f "$WORKSPACES_CONFIG" ]] && print_check "workspaces" "$WORKSPACES_CONFIG" || print_check "workspaces" "missing"
    [[ -f "$ENV_FILE" ]] && print_check "env" "$ENV_FILE" || print_check "env" "missing"
    [[ -f /lib/systemd/system/mianotes-web-service.service ]] && print_check "web service unit" "/lib/systemd/system/mianotes-web-service.service" || print_check "web service unit" "missing"
    [[ -f /lib/systemd/system/mianotes-dashboard.service ]] && print_check "dashboard unit" "/lib/systemd/system/mianotes-dashboard.service" || print_check "dashboard unit" "missing"
    echo
    echo "Tools"
    if [[ -x "$APP_ROOT/.venv/bin/python" ]]; then
      print_check "packaged python" "$("$APP_ROOT/.venv/bin/python" --version 2>&1)"
    else
      print_check "packaged python" "missing"
    fi
    command_status "python3"
    command_status "rg"
    command_status "ffmpeg"
    command_status "ffprobe"
    command_status "flac"
    command_status "metaflac"
    command_status "tesseract"
    echo
    echo "URLs"
    print_check "dashboard" "http://127.0.0.1:8201"
    print_check "api" "http://127.0.0.1:8200"
    ;;
  uninstall)
    require_root "$COMMAND"
    if command -v dpkg-query >/dev/null 2>&1 \
      && dpkg-query -W -f='${Status}' mianotes 2>/dev/null | grep -q "install ok installed"; then
      if command -v apt-get >/dev/null 2>&1; then
        apt-get remove -y mianotes
      else
        dpkg -r mianotes
      fi
      remove_system_state
    else
      systemctl disable --now mianotes-dashboard.service 2>/dev/null || true
      systemctl disable --now mianotes-web-service.service 2>/dev/null || true
      rm -f /lib/systemd/system/mianotes-dashboard.service
      rm -f /lib/systemd/system/mianotes-web-service.service
      rm -rf /opt/mianotes
      remove_system_state
      rm -f /usr/bin/mianotes
      systemctl daemon-reload 2>/dev/null || true
    fi
    cat <<'UNINSTALLED'
Mianotes has been uninstalled.

Mianotes settings, users, API keys, workspace configuration, and workspace
databases have been removed.

Your Markdown notes, source files, and published HTML have been kept under:
  /var/lib/mianotes/data

To use those files again, reinstall Mianotes and add the folder as a workspace.
UNINSTALLED
    ;;
  logs)
    journalctl -u mianotes-web-service.service -u mianotes-dashboard.service -n 120 --no-pager
    ;;
  *)
    cat <<'USAGE'
Usage: mianotes [open|status|start|stop|restart|doctor|uninstall|logs]
USAGE
    exit 2
    ;;
esac
