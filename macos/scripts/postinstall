#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="/Library/Application Support/Mianotes"
WEB_SERVICE_DIR="$APP_ROOT/web-service"
VENV_DIR="$APP_ROOT/.venv"
ENV_DIR="$APP_ROOT/env"
ENV_FILE="$ENV_DIR/mianotes.env"
LOG_DIR="/Library/Logs/Mianotes"
DATA_DIR="$APP_ROOT/data"
WORKSPACES_CONFIG="$APP_ROOT/workspaces.json"
OLD_STORAGE_CONFIG="$APP_ROOT/storage.json"
RUNTIME_ENV="$APP_ROOT/bin/runtime-env.sh"

if [[ -f "$RUNTIME_ENV" ]]; then
  # shellcheck source=/dev/null
  . "$RUNTIME_ENV"
  mianotes_export_runtime "$APP_ROOT"
fi

if ! declare -F mianotes_runtime_python >/dev/null 2>&1; then
  cat >&2 <<'PYTHON_MISSING'
Mianotes could not load its bundled runtime helpers.
Please reinstall the latest Mianotes package.
PYTHON_MISSING
  exit 1
fi

PYTHON_BIN="$(mianotes_runtime_python "$APP_ROOT" 2>/dev/null || true)"
if [[ -z "$PYTHON_BIN" || ! -x "$PYTHON_BIN" ]]; then
  cat >&2 <<'PYTHON_MISSING'
Mianotes could not find its bundled Python runtime.
Please reinstall the latest Mianotes package.
PYTHON_MISSING
  exit 1
fi

mkdir -p "$APP_ROOT" "$ENV_DIR" "$LOG_DIR" "$DATA_DIR" /usr/local/bin

if [[ ! -f "$WORKSPACES_CONFIG" && -f "$OLD_STORAGE_CONFIG" ]]; then
  mv "$OLD_STORAGE_CONFIG" "$WORKSPACES_CONFIG"
fi

if [[ ! -f "$ENV_FILE" ]]; then
  cat > "$ENV_FILE" <<ENV
MIANOTES_HOST=0.0.0.0
MIANOTES_PORT=8200
MIANOTES_DATA_DIR=$DATA_DIR
MIANOTES_STORAGE_CONFIG_PATH=$WORKSPACES_CONFIG
ENV
elif grep -qx "MIANOTES_STORAGE_CONFIG_PATH=$OLD_STORAGE_CONFIG" "$ENV_FILE"; then
  sed -i '' "s|^MIANOTES_STORAGE_CONFIG_PATH=$OLD_STORAGE_CONFIG$|MIANOTES_STORAGE_CONFIG_PATH=$WORKSPACES_CONFIG|" "$ENV_FILE"
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

export MIANOTES_HOST="${MIANOTES_HOST:-0.0.0.0}"
export MIANOTES_PORT="${MIANOTES_PORT:-8200}"
export MIANOTES_DATA_DIR="${MIANOTES_DATA_DIR:-$DATA_DIR}"
export MIANOTES_STORAGE_CONFIG_PATH="${MIANOTES_STORAGE_CONFIG_PATH:-$WORKSPACES_CONFIG}"

if [[ ! -d "$VENV_DIR" ]]; then
  "$PYTHON_BIN" -m venv "$VENV_DIR"
fi

"$VENV_DIR/bin/python" -m pip install "$WEB_SERVICE_DIR"
"$VENV_DIR/bin/mianotes-web-service" init-db

chmod 755 "$APP_ROOT/bin/start-web-service.sh" "$APP_ROOT/bin/start-dashboard.sh" "$APP_ROOT/bin/runtime-env.sh" /usr/local/bin/mianotes
chmod 644 /Library/LaunchDaemons/com.mianotes.web-service.plist /Library/LaunchDaemons/com.mianotes.dashboard.plist
chown root:wheel /Library/LaunchDaemons/com.mianotes.web-service.plist /Library/LaunchDaemons/com.mianotes.dashboard.plist

launchctl bootstrap system /Library/LaunchDaemons/com.mianotes.web-service.plist 2>/dev/null || true
launchctl bootstrap system /Library/LaunchDaemons/com.mianotes.dashboard.plist 2>/dev/null || true
launchctl kickstart -k system/com.mianotes.web-service || true
launchctl kickstart -k system/com.mianotes.dashboard || true

exit 0
