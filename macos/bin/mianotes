#!/usr/bin/env bash
set -euo pipefail

COMMAND="${1:-open}"
APP_ROOT="/Library/Application Support/Mianotes"
ENV_FILE="$APP_ROOT/env/mianotes.env"
DATA_DIR="$APP_ROOT/data"
WORKSPACES_CONFIG="$APP_ROOT/workspaces.json"
OLD_STORAGE_CONFIG="$APP_ROOT/storage.json"
RUNTIME_ENV="$APP_ROOT/bin/runtime-env.sh"
WEB_SERVICE_PLIST="/Library/LaunchDaemons/com.mianotes.web-service.plist"
DASHBOARD_PLIST="/Library/LaunchDaemons/com.mianotes.dashboard.plist"
LOG_DIR="/Library/Logs/Mianotes"

if [[ -f "$RUNTIME_ENV" ]]; then
  # shellcheck source=/dev/null
  . "$RUNTIME_ENV"
  mianotes_export_runtime "$APP_ROOT"
fi

require_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    exec sudo "$0" "$@"
  fi
}

print_check() {
  local label="$1"
  local value="$2"

  printf '  %-24s %s\n' "$label" "$value"
}

command_status() {
  local name="$1"
  local path

  if path="$(command -v "$name" 2>/dev/null)"; then
    print_check "$name" "$path"
  else
    print_check "$name" "missing"
  fi
}

launchd_status() {
  local label="$1"

  if launchctl print "system/$label" >/dev/null 2>&1; then
    print_check "$label" "running"
  else
    print_check "$label" "not running"
  fi
}

start_launchd_service() {
  local label="$1"
  local plist="$2"

  if [[ ! -f "$plist" ]]; then
    echo "Could not find $plist. Reinstall Mianotes and try again." >&2
    exit 1
  fi

  if ! launchctl print "system/$label" >/dev/null 2>&1; then
    sudo launchctl bootstrap system "$plist"
  fi

  sudo launchctl kickstart -k "system/$label"
}

remove_system_state() {
  rm -rf "$APP_ROOT/env"
  rm -f "$WORKSPACES_CONFIG" "$OLD_STORAGE_CONFIG"
  rm -f "$DATA_DIR/system.db" "$DATA_DIR/system.db-wal" "$DATA_DIR/system.db-shm" "$DATA_DIR/system.db-journal"
  rm -rf "$DATA_DIR/workspaces"
  rm -rf "$LOG_DIR"
}

case "$COMMAND" in
  open)
    open "http://127.0.0.1:8201"
    ;;
  status)
    launchctl print system/com.mianotes.web-service || true
    launchctl print system/com.mianotes.dashboard || true
    ;;
  start)
    start_launchd_service "com.mianotes.web-service" "$WEB_SERVICE_PLIST"
    start_launchd_service "com.mianotes.dashboard" "$DASHBOARD_PLIST"
    ;;
  stop)
    sudo launchctl bootout system "$DASHBOARD_PLIST" 2>/dev/null || true
    sudo launchctl bootout system "$WEB_SERVICE_PLIST" 2>/dev/null || true
    ;;
  restart)
    sudo launchctl bootout system "$DASHBOARD_PLIST" 2>/dev/null || true
    sudo launchctl bootout system "$WEB_SERVICE_PLIST" 2>/dev/null || true
    start_launchd_service "com.mianotes.web-service" "$WEB_SERVICE_PLIST"
    start_launchd_service "com.mianotes.dashboard" "$DASHBOARD_PLIST"
    ;;
  doctor)
    echo "Mianotes doctor"
    echo
    echo "Services"
    launchd_status "com.mianotes.web-service"
    launchd_status "com.mianotes.dashboard"
    echo
    echo "Files"
    [[ -d "$APP_ROOT" ]] && print_check "app root" "$APP_ROOT" || print_check "app root" "missing"
    [[ -d "$DATA_DIR" ]] && print_check "data" "$DATA_DIR" || print_check "data" "missing"
    [[ -f "$WORKSPACES_CONFIG" ]] && print_check "workspaces" "$WORKSPACES_CONFIG" || print_check "workspaces" "missing"
    [[ -f "$ENV_FILE" ]] && print_check "env" "$ENV_FILE" || print_check "env" "missing"
    [[ -f "$WEB_SERVICE_PLIST" ]] && print_check "web service plist" "$WEB_SERVICE_PLIST" || print_check "web service plist" "missing"
    [[ -f "$DASHBOARD_PLIST" ]] && print_check "dashboard plist" "$DASHBOARD_PLIST" || print_check "dashboard plist" "missing"
    echo
    echo "Bundled runtime"
    if declare -F mianotes_runtime_dir >/dev/null 2>&1; then
      RUNTIME_DIR="$(mianotes_runtime_dir "$APP_ROOT" 2>/dev/null || true)"
      [[ -n "$RUNTIME_DIR" && -d "$RUNTIME_DIR" ]] && print_check "runtime" "$RUNTIME_DIR" || print_check "runtime" "missing"
      [[ -x "$RUNTIME_DIR/python/bin/python3" ]] && print_check "runtime python" "$("$RUNTIME_DIR/python/bin/python3" --version 2>&1)" || print_check "runtime python" "missing"
      [[ -x "$RUNTIME_DIR/bin/rg" ]] && print_check "runtime rg" "$RUNTIME_DIR/bin/rg" || print_check "runtime rg" "missing"
      [[ -x "$RUNTIME_DIR/bin/ffmpeg" ]] && print_check "runtime ffmpeg" "$RUNTIME_DIR/bin/ffmpeg" || print_check "runtime ffmpeg" "missing"
      [[ -x "$RUNTIME_DIR/bin/ffprobe" ]] && print_check "runtime ffprobe" "$RUNTIME_DIR/bin/ffprobe" || print_check "runtime ffprobe" "missing"
      [[ -x "$RUNTIME_DIR/bin/tesseract" ]] && print_check "runtime tesseract" "$RUNTIME_DIR/bin/tesseract" || print_check "runtime tesseract" "missing"
    else
      print_check "runtime" "missing"
    fi
    echo
    echo "Tools"
    if [[ -x "$APP_ROOT/.venv/bin/python" ]]; then
      print_check "packaged python" "$("$APP_ROOT/.venv/bin/python" --version 2>&1)"
    else
      print_check "packaged python" "missing"
    fi
    command_status "python3"
    command_status "rg"
    command_status "ffmpeg"
    command_status "ffprobe"
    command_status "tesseract"
    echo
    echo "URLs"
    print_check "dashboard" "http://127.0.0.1:8201"
    print_check "api" "http://127.0.0.1:8200"
    ;;
  uninstall)
    require_root "$COMMAND"
    launchctl bootout system "$DASHBOARD_PLIST" 2>/dev/null || true
    launchctl bootout system "$WEB_SERVICE_PLIST" 2>/dev/null || true
    rm -f /Library/LaunchDaemons/com.mianotes.dashboard.plist
    rm -f /Library/LaunchDaemons/com.mianotes.web-service.plist
    rm -rf "$APP_ROOT/.venv"
    rm -rf "$APP_ROOT/bin"
    rm -rf "$APP_ROOT/dashboard"
    rm -rf "$APP_ROOT/runtime"
    rm -rf "$APP_ROOT/web-service"
    remove_system_state
    rm -f /usr/local/bin/mianotes
    pkgutil --forget com.mianotes.installer >/dev/null 2>&1 || true
    cat <<UNINSTALLED
Mianotes has been uninstalled.

Mianotes settings, users, API keys, workspace configuration, and workspace
databases have been removed.

Your Markdown notes, source files, and published HTML have been kept under:
  $APP_ROOT/data

To use those files again, reinstall Mianotes and add the folder as a workspace.
UNINSTALLED
    ;;
  logs)
    tail -n 80 /Library/Logs/Mianotes/web-service.log /Library/Logs/Mianotes/dashboard.log
    ;;
  *)
    cat <<'USAGE'
Usage: mianotes [open|status|start|stop|restart|doctor|uninstall|logs]
USAGE
    exit 2
    ;;
esac
