#!/usr/bin/env bash
set -euo pipefail

COMMAND="${1:-open}"
APP_ROOT="/Library/Application Support/Mianotes"

require_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    exec sudo "$0" "$@"
  fi
}

case "$COMMAND" in
  open)
    open "http://127.0.0.1:8201"
    ;;
  status)
    launchctl print system/com.mianotes.web-service || true
    launchctl print system/com.mianotes.dashboard || true
    ;;
  start)
    sudo launchctl kickstart -k system/com.mianotes.web-service
    sudo launchctl kickstart -k system/com.mianotes.dashboard
    ;;
  stop)
    sudo launchctl bootout system /Library/LaunchDaemons/com.mianotes.dashboard.plist 2>/dev/null || true
    sudo launchctl bootout system /Library/LaunchDaemons/com.mianotes.web-service.plist 2>/dev/null || true
    ;;
  uninstall)
    require_root "$COMMAND"
    launchctl bootout system /Library/LaunchDaemons/com.mianotes.dashboard.plist 2>/dev/null || true
    launchctl bootout system /Library/LaunchDaemons/com.mianotes.web-service.plist 2>/dev/null || true
    rm -f /Library/LaunchDaemons/com.mianotes.dashboard.plist
    rm -f /Library/LaunchDaemons/com.mianotes.web-service.plist
    rm -rf "$APP_ROOT/.venv"
    rm -rf "$APP_ROOT/bin"
    rm -rf "$APP_ROOT/dashboard"
    rm -rf "$APP_ROOT/web-service"
    rm -f /usr/local/bin/mianotes
    pkgutil --forget com.mianotes.installer >/dev/null 2>&1 || true
    cat <<UNINSTALLED
Mianotes has been uninstalled.

Your data has been kept at:
  $APP_ROOT/data

Your environment and workspace configuration have also been kept:
  $APP_ROOT/env
  $APP_ROOT/workspaces.json
UNINSTALLED
    ;;
  logs)
    tail -n 80 /Library/Logs/Mianotes/web-service.log /Library/Logs/Mianotes/dashboard.log
    ;;
  *)
    cat <<'USAGE'
Usage: mianotes [open|status|start|stop|uninstall|logs]
USAGE
    exit 2
    ;;
esac
